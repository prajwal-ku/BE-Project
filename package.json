{
  "name": "agritrace-blockchain",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "start": "next start",
    "chaincode:build": "cd blockchain/chaincode && go build",
    "chaincode:test": "cd blockchain/chaincode && go test",
    "blockchain:compile": "cd blockchain && npx truffle compile",
    "blockchain:migrate": "cd blockchain && npx truffle migrate --network ganache",
    "blockchain:migrate:reset": "cd blockchain && npx truffle migrate --reset --network ganache",
    "blockchain:console": "cd blockchain && npx truffle console --network ganache",
    "blockchain:test": "cd blockchain && npx truffle test --network ganache",
    "deploy": "npm run blockchain:compile && npm run blockchain:migrate",
    "deploy:reset": "npm run blockchain:compile && npm run blockchain:migrate:reset",
    "test:contract": "npm run blockchain:test"
  },
